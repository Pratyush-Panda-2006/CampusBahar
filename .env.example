# PravasiTrail (CampusBahar) Environment Configuration

# Server Settings
PROJECT_NAME="PravasiTrail (CampusBahar)"
DEBUG=True
HOST=0.0.0.0
PORT=8000

# Campus & Hostel Anchors (ITER SOA University, Jagamara, Bhubaneswar)
CAMPUS_NAME="Institute of Technical Education and Research (ITER), SOA"
CAMPUS_LAT=20.2520
CAMPUS_LON=85.7956
HOSTEL_CURFEW_HOUR=20

# TabPFN Settings
TABPFN_DEVICE=cpu
TABPFN_N_ENSEMBLE=4

# LLM Providers (Optional - Full offline fallback works automatically)
# Groq Cloud (Primary for fast inference)
GROQ_API_KEY=

# Google Gemini
GEMINI_API_KEY=
GEMINI_MODEL=gemini-1.5-flash


# Local Ollama
OLLAMA_BASE_URL=http://localhost:11434
OLLAMA_MODEL=llama3.2
USE_OLLAMA_FALLBACK=True
