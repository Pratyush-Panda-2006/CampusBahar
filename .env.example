# PravasiTrail (CampusBahar) Environment Configuration Template
# Copy this file to .env and fill in your actual API keys.
# .env is ignored by .gitignore and will not be pushed to GitHub.

# Server Settings
PROJECT_NAME="PravasiTrail (CampusBahar)"
DEBUG=True
HOST=0.0.0.0
PORT=8000

# Campus & Hostel Anchors (ITER SOA University, Jagamara, Bhubaneswar)
CAMPUS_NAME="Institute of Technical Education and Research (ITER), SOA"
CAMPUS_LAT=20.2520
CAMPUS_LON=85.7956
HOSTEL_CURFEW_HOUR=20

# TabPFN Settings
TABPFN_DEVICE=cpu
TABPFN_N_ENSEMBLE=4

# LLM Providers (No Ollama used)
# 1. Groq Cloud (Primary for ultra-fast generation)
GROQ_API_KEY=your_groq_api_key_here

# 2. Google Gemini (Secondary fallback / alternative model)
GEMINI_API_KEY=your_gemini_api_key_here
GEMINI_MODEL=gemini-2.5-flash

# 3. Google Maps API
GOOGLE_MAPS_API_KEY=your_google_maps_api_key_here

# 4. ElevenLabs Audio Narration
ELEVENLABS_API_KEY=your_elevenlabs_api_key_here
